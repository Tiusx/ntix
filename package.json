{
  "name": "ntix",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tiusx/ntix.git"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/sync-memos.ts && tsx scripts/generate-search-index.ts && tsx scripts/generate-og.tsx",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "sync:memos": "tsx scripts/sync-memos.ts",
    "sync:memos:strict": "tsx scripts/sync-memos.ts --strict",
    "sync:memos:dry": "tsx scripts/sync-memos.ts --dry-run",
    "sync:all": "tsx scripts/sync-all.ts",
    "sync:all:strict": "tsx scripts/sync-all.ts --strict",
    "sync:all:full": "tsx scripts/sync-all.ts --full-sync",
    "sync:all:full:strict": "tsx scripts/sync-all.ts --full-sync --strict",
    "sync:all:dry": "tsx scripts/sync-all.ts --full-sync --dry-run",
    "sync:posts": "tsx scripts/notion/fetch-posts.ts",
    "sync:posts:strict": "tsx scripts/notion/fetch-posts.ts --strict",
    "sync:posts:full": "tsx scripts/notion/fetch-posts.ts --full-sync",
    "sync:posts:full:strict": "tsx scripts/notion/fetch-posts.ts --full-sync --strict",
    "sync:posts:force": "tsx scripts/notion/fetch-posts.ts --force",
    "sync:posts:dry": "tsx scripts/notion/fetch-posts.ts --full-sync --dry-run",
    "sync:pages": "tsx scripts/notion/fetch-pages.ts",
    "sync:pages:strict": "tsx scripts/notion/fetch-pages.ts --strict",
    "sync:pages:full": "tsx scripts/notion/fetch-pages.ts --full-sync",
    "sync:pages:full:strict": "tsx scripts/notion/fetch-pages.ts --full-sync --strict",
    "sync:pages:force": "tsx scripts/notion/fetch-pages.ts --force",
    "sync:pages:dry": "tsx scripts/notion/fetch-pages.ts --full-sync --dry-run",
    "migrate:pages": "tsx scripts/notion/migrate-pages.ts",
    "submit:indexnow": "tsx scripts/submit-indexnow.ts",
    "migrate:notion": "tsx scripts/notion/migrate-to-notion.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.4",
    "@notionhq/client": "^5.26.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tryfabric/martian": "^1.2.4",
    "@types/mdx": "^2.0.14",
    "@waline/client": "^3.15.2",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "next": "16.3.4",
    "notion-to-md": "^3.1.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.34.5"
}
