# Memos 说说（构建与同步时拉取；留空则用脚本默认值 https://memos.tius.cn/api/v1/memos）
# 自建实例需先开启匿名公开访问，详见 docs/memos-setup.md
MEMOS_API=

# Site（构建时可覆盖，默认值见 src/site.config.ts）
SITE_URL=

# Notion CMS（文章源，见 scripts/notion/）
NOTION_API_SECRET=
# 迁移脚本自动创建后会回填；或手动建库后填写
NOTION_POSTS_DATABASE_ID=
# 自定义页面源（关于/友联/简历等，见 scripts/notion/fetch-pages.ts）
NOTION_PAGES_DATABASE_ID=
# 迁移脚本需在建库前指定归属页面
NOTION_PAGE_ID=

# R2 图床（文章图片转存；桶与域名默认 cf-imgbed / https://r2.tius.cn）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cf-imgbed
R2_PUBLIC_DOMAIN=https://r2.tius.cn
# 图片转码（同步时生效）：JPEG/PNG/WebP/BMP/HEIC 统一转 WebP，始终剥离 EXIF/GPS/ICC
# 有损质量 1-100，默认 82（配 smartSubsample；调高到 90~95 可减少压缩痕迹，代价是体积成倍增长）；R2_IMAGE_LOSSLESS=1 时忽略该项
R2_IMAGE_QUALITY=82
# 长边上限，超出等比缩小、小图不放大；设 0 表示保留原始尺寸（文件会明显变大）
R2_IMAGE_MAX_WIDTH=2560
# 1 = WebP 无损编码：像素级无损，但体积约是有损 q82 的 5~8 倍（照片上会远超原图）
R2_IMAGE_LOSSLESS=0

# 评论提供方：giscus（默认，零服务端）| waline（自建服务端）| none（关闭评论区）
NEXT_PUBLIC_COMMENT_PROVIDER=giscus

# Waline 评论（provider=waline 时生效；缺失则不渲染）
# 部署方式见 https://waline.js.org/guide/get-started/，填到部署后的访问地址
NEXT_PUBLIC_WALINE_SERVER_URL=

# Giscus 评论（详见 https://giscus.app；缺失则评论区不渲染）
NEXT_PUBLIC_GISCUS_REPO=Tiusx/comments
# 下列 3 项由 giscus.app 按 repo 生成
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# IndexNow（Bing/Google 主动推送；key 需与 public/indexnow-key-<KEY>.txt 内容一致）
INDEXNOW_KEY=